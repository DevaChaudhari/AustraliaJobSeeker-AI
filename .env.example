# Required
GROQ_API_KEY=your_groq_api_key

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=australiajobseeker-ai

# Optional: scraper and response limits
SEEK_MAX_PAGES=1
SEEK_MAX_JOBS=10
SEEK_PAGE_WAIT_MS=3000
JOB_DETAIL_WAIT_MS=3000
MAX_RESPONSE_JOBS=10

# Optional: API port (default 8000)
PORT=8000
